# Data files
data/raw/*.csv

# Model objects (large)
models/**/*.rds
output/**/*.rds
simulation_output/*.rds

# Simulation precompiled models
code/Simulations/*.rds

# R session files
.Rhistory
.RData
.Rproj.user/

# Figures (reproducible from code)
figs/*.png

# Allow figures referenced directly in the user guide
!figs/srd_mean_all.png
tables/*.md
tables/*.rds


# OS and temp files
Thumbs.db
.DS_Store
~$*
~*.tmp
.claude/

# Compiled tex artifacts
*.aux
*.log
*.tex
*.out
*.synctex.gz
*.fls
*.fdb_latexmk
*.knit.md

# Derived data
data/derived/PoststratCountsCanada.csv
data/derived/PoststratCountsWetland.csv
data/derived/SRDClean.csv

# Quarto rendered outputs (not needed — embed-resources: true makes HTML self-contained)
docs/*_files/
README.html
README_files/

# Allow .gitkeep files in otherwise-ignored directories
!**/.gitkeep
